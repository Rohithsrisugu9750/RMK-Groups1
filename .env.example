# RMK Groups - Environment Variables Template
# Copy this file to .env and configure your production credentials.
# NEVER commit your real .env file with secrets to Git or share it publicly!

DB_HOST=127.0.0.1
DB_USER=your_mysql_username
DB_PASSWORD="your_mysql_password"
DB_NAME=your_mysql_database
DB_PORT=3306
PORT=3000
SYNC_AUTH_TOKEN="your_secure_random_api_secret_token"
